{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File (Integrated Terminal)",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: main.py (App)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}\\main.py",
      "console": "integratedTerminal"
    }
  ]
}
