# Python キャッシュ
__pycache__/
*.pyc

# ログ
*.log

# SQLite DB（本番DBをGit管理しない場合）
*.db

# DBロックファイル（services/db_lock_service.py、"<DBファイル名>.lock"形式）。
# "*.db"パターンには一致しない（拡張子が.lockのため）ため個別に追加する。
# 実行時に作成・削除される runtime ファイルで、約1か月の間に9回誤って
# コミットに混入していたことが判明したため除外した
# （CANONICAL_DESIGN_DECISIONS.md参照）。
*.db.lock

# 環境ファイル
.env
.env.*

# OS依存
.DS_Store

# Venv
venv/
.venv/

# Node（もし存在する場合）
node_modules/

# Tesseract OCR言語データ（開発環境ごとに個別インストール、容量が大きくGit管理しない）
inventory_app/tessdata_local/
inventory_app/tessdata_local_backup/

# アプリ永続設定（選択中DBパス等、実行環境ごとに異なる実行時生成ファイル）
inventory_app/app_settings.json

# PyInstallerのビルド成果物（inventory_app.spec参照）。ビルドのたびに
# ローカルで再生成されるものであり、.exe本体（100MB超）を含むためGit管理しない。
build/
dist/

# Python ソースコードはすべて追跡対象
!*.py
