# Python キャッシュ
__pycache__/
*.pyc

# ログ
*.log

# SQLite DB（本番DBをGit管理しない場合）
*.db

# 環境ファイル
.env
.env.*

# OS依存
.DS_Store

# Venv
venv/
.venv/

# Node（もし存在する場合）
node_modules/

# Tesseract OCR言語データ（開発環境ごとに個別インストール、容量が大きくGit管理しない）
inventory_app/tessdata_local/

# アプリ永続設定（選択中DBパス等、実行環境ごとに異なる実行時生成ファイル）
inventory_app/app_settings.json

# Python ソースコードはすべて追跡対象
!*.py
